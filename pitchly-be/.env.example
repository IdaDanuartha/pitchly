# --- Database ---
POSTGRES_USER=pitchly
POSTGRES_PASSWORD=pitchly
POSTGRES_DB=pitchly

# --- Auth ---
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- LLM (jangan pernah diekspos ke frontend) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gemini-3.6-flash,gemini-2.5-flash,gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Email verifikasi (Resend) ---
# Kosongkan RESEND_API_KEY untuk auto-verify (tanpa email) saat dev.
RESEND_API_KEY=
EMAIL_FROM="Pitchly <onboarding@resend.dev>"
APP_BASE_URL=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Avatar 3D (opsional) ---
# URL .glb Ready Player Me per persona (buat gratis di readyplayer.me).
# Kosongkan untuk pakai avatar 2D SVG. Di-inline saat build frontend.
NEXT_PUBLIC_RPM_TEKNIS=
NEXT_PUBLIC_RPM_DAMPAK=
NEXT_PUBLIC_RPM_SKEPTIS=

# --- Avatar D-ID (talking photo photoreal + lip-sync nyata, opsional) ---
DID_API_KEY=
DID_SOURCE_TEKNIS=
DID_SOURCE_DAMPAK=
DID_SOURCE_SKEPTIS=

# --- Cek orisinalitas via web search (opsional) ---
# Isi API key Tavily (tavily.com) untuk cek solusi sejenis langsung dari web.
# Kosong = fallback ke basis solusi internal (seed lokal).
TAVILY_API_KEY=

# --- Enkripsi dokumen at-rest (opsional) ---
# Isi string rahasia apa pun untuk mengenkripsi berkas yang diunggah di disk.
# Kosongkan = simpan plaintext. Jangan ganti setelah ada dokumen (tak bisa didekripsi).
DOCUMENT_ENCRYPTION_KEY=